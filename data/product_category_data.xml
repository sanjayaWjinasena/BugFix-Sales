<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_jin_company_id_in_product_category" model="ir.actions.server">
    <field name="name">JIN - Company Id in Product Category</field>
    <field name="model_id" search="[('model', '=', 'product.category')]"/>
    <field name="state">code</field>
    <field name="usage">base_automation</field>
    <field name="code">if record.id == False:
 company_id = env.context.get('allowed_company_ids', [env.user.company_id.id])[0]
 company = env['res.company'].browse(company_id)
    
 record['accounting_company_id'] = company.id


</field>
  </record>
  <!-- STRIPPED action_sls_minimum_sales_margin_in_setup_page: model minimum_sales_margin not on target -->
  <record id="automation_jin_company_id_in_product_category" model="base.automation">
    <field name="name">JIN - Company Id in Product Category</field>
    <field name="active" eval="True"/>
    <field name="model_id" search="[('model', '=', 'product.category')]"/>
    <field name="trigger">on_create_or_write</field>
    <field name="trigger_field_ids" eval="[(6, 0, [ref('product.field_product_category__create_date')])]"/>
    <field name="action_server_ids" eval="[(6, 0, [ref('BugFix-Sales.action_jin_company_id_in_product_category')])]"/>
  </record>
  <!-- STRIPPED automation_sls_minimum_sales_margin_in_setup_page: model minimum_sales_margin not on target -->
</odoo>
