<!-- BugFix-Sales backlog: 4 window actions --><odoo>

  <record id="act_window_3636_document_conclusions" model="ir.actions.act_window">
    <field name="name">Document Conclusions</field>
    <field name="res_model">bugfix_sales.doc_conclusion</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                Create a Document Conclusion
            </p>
            <p>
                Conclusions are reusable blocks of text printed after the totals on a
                quotation — typically Availability, Terms of Payment, Delivery,
                Guarantee, and the closing salutation. Pick one on a Sales Order and
                edit the copy per-quote if needed.
            </p>
        </field>
  </record>

  <record id="act_window_3635_document_introductions" model="ir.actions.act_window">
    <field name="name">Document Introductions</field>
    <field name="res_model">bugfix_sales.doc_intro</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                Create a Document Introduction
            </p>
            <p>
                Introductions are reusable blocks of text printed at the top of a
                quotation, between the customer address and the order lines. Pick one
                on a Sales Order and edit the copy per-quote if needed.
            </p>
        </field>
  </record>

