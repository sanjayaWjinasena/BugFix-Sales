<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_ccd4306a_1ac9_43c7_847f_965bdab82885" model="ir.ui.view">
    <field name="name">Default form view for x_delivery_terms</field>
    <field name="model">x_delivery_terms</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header>  
          
          
        </header>
        <header/>
        <header/>
        <sheet string="Delivery Terms">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_4e0e58">
            <group name="studio_group_4e0e58_left"/>
            <group name="studio_group_4e0e58_right"/>
          </group>
        </sheet>
        <div class="oe_chatter" name="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
          <field name="activity_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="ported_odoo_studio_default__2950672a_3dcb_4c5f_9e9b_bf4f4fd723c6" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for x_delivery_terms customization</field>
    <field name="model">x_delivery_terms</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Sales.ported_default_form_view_fo_ccd4306a_1ac9_43c7_847f_965bdab82885"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//form[1]/sheet[1]/div[1]/h1[1]/field[@name='x_name']" position="attributes">
          <attribute name="string">Delivery Term</attribute>
        </xpath>
        <xpath expr="//group[@name='studio_group_4e0e58_left']" position="inside">
          <field name="x_studio_description" string="Description" help="Description of the Delivery Term / Incoterm."/>
          <field name="x_studio_vendor_despatch" string="Vendor Dispatch Voucher" widget="boolean_toggle" help="Determines whether to update ledger or not, when updating the &quot;Vendor Dispatch&quot;. If ticked, a voucher will be posted which will update the &quot;Goods in transit&quot; in ledger."/>
          <field name="x_studio_company_id" string="Company"/>
          <field name="x_studio_copied" string="Copied" invisible="1"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_4e0e58']" position="after">
          <notebook name="studio_notebook_SZ2rh">
            <page string="Charges" name="studio_page_SZ2rh">
              <field name="x_studio_delivery_terms_id" string="Delivery Terms Id">
                <tree editable="bottom" create="false" delete="false">
                  <field name="x_name" force_save="True" readonly="1"/>
                  <field name="x_studio_description" force_save="True" readonly="1"/>
                  <field name="x_studio_applicable" column_invisible="1"/>
                  <field name="x_studio_tax_appicable" string="Include in Duty Calculation"/>
                  <field name="x_studio_tax_appicable2" string="Handled by Supplier"/>
                  <field optional="show" name="x_studio_company_id" string="Company" column_invisible="1"/>
                  <field name="x_studio_sequence" widget="handle" column_invisible="1"/>
                </tree>
                <form>
                  <header/>
                  <sheet string="Delivery Term Charges" name="studio_sheet_091629">
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
                    <field name="x_active" invisible="1"/>
                    <div class="oe_title" name="studio_div_03a502">
                      <h1>
                        <field name="x_name" required="1" placeholder="Name..." string="Charge Name"/>
                      </h1>
                    </div>
                    <group name="studio_group_c9766e">
                      <group name="studio_group_c9766e_left">
                        <field name="x_studio_description" string="Description"/>
                        <field name="x_studio_applicable" string="Handled by Supplier" help="Determines whether the service is handled by supplier or us. If handled by the main supplier, this field should be ticked and the charge is included in the supplier's Invoice &amp; such amounts are to be paid to the supplier along with the cost of goods purchased. If not handled by the main supplier, it means such services are provided by third party suppliers and shuch charges to be invoiced to relevant third party suppliers using TP-Invoicing."/>
                        <field name="x_studio_tax_appicable" help="Determines whether the charge is included in Assessable Value, which is the base for Duty and Tax calculations."/>
                        <field name="x_studio_delivery_terms_id" string="Delivery Terms Id" invisible="1"/>
                      </group>
                      <group name="studio_group_c9766e_right"/>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
          </notebook>
        </xpath>
      </data>
    </field>
  </record>
</odoo>
