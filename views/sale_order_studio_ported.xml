<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_odoo_studio_sale_ord_ec04cc0c_2274_4a3f_8a1d_c240a65d1ca3" model="ir.ui.view">
    <field name="name">Odoo Studio: sale.order.form customization</field>
    <field name="model">sale.order</field>
    <field name="key">studio_customization.odoo_studio_sale_ord_ec04cc0c-2274-4a3f-8a1d-c240a65d1ca3</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//form[1]" position="attributes">
          <attribute name="create">false</attribute>
        </xpath>

        <!--1.2.2 Overdue Control in Sales Orders (Slice C, v0.1.0.121)
             Ported from CDB view 2304. RUG buttons (1980/1981/2004) stay
             with Fix-repair; positional xpath target //button[@name='508']
             from CDB replaced with semantic //header position=inside
             (name=508 doesn't exist on Dev's composed arch).  -->
        <xpath expr="//sheet" position="inside">
          <field name="x_studio_overdue" invisible="1"/>
          <field name="x_studio_overdue_approved" invisible="1"/>
          <field name="x_studio_overdue_request_sent" invisible="1"/>
          <field name="x_studio_valid_order_lines" invisible="1"/>
          <field name="x_studio_clear_free_items" invisible="1"/>
          <field name="x_studio_expired" invisible="1"/>
        </xpath>
        <xpath expr="//header" position="inside">
          <button type="action"
                  name="%(BugFix-Sales.server_action_1476_sls_request_overdue_approval)d"
                  string="Request Overdue Approval"
                  class="btn-primary"
                  invisible="(state == 'cancel') or ((x_studio_overdue_request_sent == True) or ((x_studio_overdue_approved == True) or ((x_studio_overdue != True) or ((x_studio_valid_order_lines == False) or ((state == 'done') or ((x_studio_clear_free_items == True) or (x_studio_expired == True)))))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1478_sls_overdue_approval)d"
                  string="Approve Overdue"
                  class="btn-primary"
                  studio_approval="True"
                  invisible="(state == 'cancel') or ((x_studio_overdue_request_sent == False) or ((x_studio_overdue_approved == True) or ((x_studio_overdue != True) or ((x_studio_clear_free_items == True) or (x_studio_expired == True)))))"/>
        </xpath>

        <!--1.2.9 Commission Control in Sales Orders (Slice F, v0.1.0.123).
             Ported from CDB view 2304.  -->
        <xpath expr="//sheet" position="inside">
          <field name="x_studio_over_commission" invisible="1"/>
          <field name="x_studio_over_commission_approved" invisible="1"/>
          <field name="x_studio_over_comm_approval_request_sent" invisible="1"/>
        </xpath>
        <xpath expr="//header" position="inside">
          <button type="action"
                  name="%(BugFix-Sales.server_action_1503_sls_request_over_commission_approval)d"
                  string="Request Over Commission Approval"
                  class="btn-primary"
                  invisible="(state == 'cancel') or ((x_studio_over_comm_approval_request_sent == True) or ((x_studio_over_commission_approved == True) or ((x_studio_over_commission != True) or ((x_studio_valid_order_lines == False) or ((state == 'done') or ((x_studio_clear_free_items == True) or (x_studio_expired == True)))))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1505_sls_over_commission_approval_main)d"
                  string="Approve Over Commission"
                  class="btn-primary"
                  studio_approval="True"
                  invisible="(state == 'cancel') or ((x_studio_over_comm_approval_request_sent == False) or ((x_studio_over_commission_approved == True) or ((x_studio_over_commission != True) or (x_studio_expired == True))))"/>
        </xpath>

        <!--1.2.10 Margin Control in Sales Orders (Slice G, v0.1.0.124).
             Ported from CDB view 2304. Fields on Dev are x_studio_margin_exceed /
             _approved / _approval_request_sent (NOT x_studio_over_margin_* — that
             prefix guess was wrong; verified via fields_get on Dev before shipping).
             Details button (1517) uses btn-secondary and opens Item Over Margin
             list modal. Reuses valid_order_lines / clear_free_items / expired /
             overdue sentinels declared in Slice C.  -->
        <xpath expr="//sheet" position="inside">
          <field name="x_studio_margin_exceed" invisible="1"/>
          <field name="x_studio_margin_approved" invisible="1"/>
          <field name="x_studio_margin_approval_request_sent" invisible="1"/>
        </xpath>
        <xpath expr="//header" position="inside">
          <button type="action"
                  name="%(BugFix-Sales.server_action_1513_sls_request_margin_approval)d"
                  string="Request Margin Approval"
                  class="btn-primary"
                  invisible="(state == 'cancel') or ((x_studio_margin_approval_request_sent == True) or ((x_studio_margin_approved == True) or ((x_studio_margin_exceed != True) or ((x_studio_valid_order_lines == False) or ((state == 'done') or ((x_studio_clear_free_items == True) or (x_studio_expired == True)))))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1515_sls_margin_approval_main)d"
                  string="Approve Margin"
                  class="btn-primary"
                  studio_approval="True"
                  invisible="(state == 'cancel') or ((x_studio_margin_approval_request_sent == False) or ((x_studio_margin_approved == True) or ((x_studio_margin_exceed != True) or (x_studio_expired == True))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1517_sls_item_over_margin_details)d"
                  string="Margin Details"
                  class="btn-secondary"
                  invisible="(state == 'cancel') or ((x_studio_margin_exceed != True) or (x_studio_expired == True))"/>
        </xpath>

        <!--1.2.11 Credit Limit + Temp Credit Control in Sales Orders
             (Slice D, v0.1.0.125). Ported from CDB view 2304.
             Fields verified via fields_get on Dev — the credit-limit request-sent
             flag is the GENERIC x_studio_approval_request_sent (no credit_ prefix),
             separate from x_studio_tem_credit_approval_request_sent for temp credit.
             x_studio_order_payment_method is a selection ('Cash'/'Credit') — credit
             buttons are gated on == 'Credit'. Reuses valid_order_lines /
             clear_free_items / expired sentinels from Slice C.  -->
        <xpath expr="//sheet" position="inside">
          <field name="x_studio_over_credit" invisible="1"/>
          <field name="x_studio_credit_limit_approved" invisible="1"/>
          <field name="x_studio_approval_request_sent" invisible="1"/>
          <field name="x_studio_credit_limit_validation" invisible="1"/>
          <field name="x_studio_order_payment_method" invisible="1"/>
          <field name="x_studio_grant_temporary_credit" invisible="1"/>
          <field name="x_studio_temporary_credit_approved" invisible="1"/>
          <field name="x_studio_tem_credit_approval_request_sent" invisible="1"/>
        </xpath>
        <xpath expr="//header" position="inside">
          <button type="action"
                  name="%(BugFix-Sales.server_action_1458_sls_request_credit_limit_approval)d"
                  string="Request Credit Limit Approval"
                  class="btn-primary"
                  invisible="(state == 'cancel') or ((x_studio_approval_request_sent == True) or ((x_studio_credit_limit_approved == True) or ((x_studio_over_credit != True) or ((x_studio_order_payment_method != 'Credit') or ((x_studio_valid_order_lines == False) or ((state == 'done') or ((x_studio_clear_free_items == True) or (x_studio_expired == True))))))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1435_sls_credit_limit_approval_main)d"
                  string="Approve Credit Limit"
                  class="btn-primary"
                  studio_approval="True"
                  invisible="(state == 'cancel') or ((x_studio_approval_request_sent == False) or ((x_studio_credit_limit_approved == True) or ((x_studio_over_credit != True) or ((x_studio_order_payment_method != 'Credit') or (x_studio_expired == True)))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1853_sls_view_credit_limit_validation)d"
                  string="View Credit Limit Validation"
                  class="btn-secondary"
                  invisible="(state == 'cancel') or (x_studio_credit_limit_validation != True)"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1468_sls_request_temporary_credit_approval)d"
                  string="Request Temporary Credit Approval"
                  class="btn-primary"
                  invisible="(state == 'cancel') or ((x_studio_tem_credit_approval_request_sent == True) or ((x_studio_temporary_credit_approved == True) or ((x_studio_grant_temporary_credit != True) or ((x_studio_order_payment_method != 'Credit') or ((x_studio_valid_order_lines == False) or ((state == 'done') or ((x_studio_clear_free_items == True) or (x_studio_expired == True))))))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1470_sls_temporary_credit_approval_main)d"
                  string="Approve Temporary Credit"
                  class="btn-primary"
                  studio_approval="True"
                  invisible="(state == 'cancel') or ((x_studio_tem_credit_approval_request_sent == False) or ((x_studio_temporary_credit_approved == True) or ((x_studio_grant_temporary_credit != True) or ((x_studio_order_payment_method != 'Credit') or (x_studio_expired == True)))))"/>
        </xpath>

        <!--1.2.12 Bank Guarantee + BG Notification in Sales Orders
             (Slice E, v0.1.0.126). Ported from CDB view 2304.
             Trigger x_studio_over_bank_guarantee, approved flag
             x_studio_bank_guarantee_approved, request-sent
             x_studio_bank_guarantee_request_sent (BG has its own dedicated
             request-sent field, unlike credit-limit which reuses the generic
             x_studio_approval_request_sent). BG buttons NOT gated on payment
             method — BG applies regardless of Cash/Credit.
             Reuses valid_order_lines / clear_free_items / expired sentinels
             from Slice C.  -->
        <xpath expr="//sheet" position="inside">
          <field name="x_studio_over_bank_guarantee" invisible="1"/>
          <field name="x_studio_bank_guarantee_approved" invisible="1"/>
          <field name="x_studio_bank_guarantee_request_sent" invisible="1"/>
          <field name="x_studio_bank_guarantee_validation" invisible="1"/>
          <field name="x_studio_bank_guarantee_notification" invisible="1"/>
          <field name="x_studio_bg_sent" invisible="1"/>
        </xpath>
        <xpath expr="//header" position="inside">
          <button type="action"
                  name="%(BugFix-Sales.server_action_1485_sls_request_bank_guarantee_approval)d"
                  string="Request Bank Guarantee Approval"
                  class="btn-primary"
                  invisible="(state == 'cancel') or ((x_studio_bank_guarantee_request_sent == True) or ((x_studio_bank_guarantee_approved == True) or ((x_studio_over_bank_guarantee != True) or ((x_studio_valid_order_lines == False) or ((state == 'done') or ((x_studio_clear_free_items == True) or (x_studio_expired == True)))))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1487_sls_bank_guarantee_approval_main)d"
                  string="Approve Bank Guarantee"
                  class="btn-primary"
                  studio_approval="True"
                  invisible="(state == 'cancel') or ((x_studio_bank_guarantee_request_sent == False) or ((x_studio_bank_guarantee_approved == True) or ((x_studio_over_bank_guarantee != True) or (x_studio_expired == True))))"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1849_sls_view_bank_guarantee_validation)d"
                  string="View BG Validation"
                  class="btn-secondary"
                  invisible="(state == 'cancel') or (x_studio_bank_guarantee_validation != True)"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_1850_sls_send_bank_guarantee_notification_main)d"
                  string="Send BG Notification"
                  class="btn-secondary"
                  invisible="(state == 'cancel') or ((x_studio_bank_guarantee_notification != True) or (x_studio_bg_sent == True))"/>
        </xpath>

        <!--1.2.13 Transfer Inventory + Customer Payment (Slice H, v0.1.0.127).
             Ported from CDB view 2304. Cross-app buttons — 2096 opens
             insufficient-transfer inventory details (Stock), 2341 creates
             a customer payment record (Accounting). Both actions live in
             BugFix-Sales/data/server_actions_v2.xml (no cross-repo depends
             needed since BugFix-Sales already depends on stock + account
             transitively via sale_stock + sale).  -->
        <xpath expr="//sheet" position="inside">
          <field name="x_studio_inventory_short" invisible="1"/>
          <field name="x_studio_customer_payment_method" invisible="1"/>
        </xpath>
        <xpath expr="//header" position="inside">
          <button type="action"
                  name="%(BugFix-Sales.server_action_2096_rr_insufficient_transfer_inventory_details)d"
                  string="View Transfer Inventory Details"
                  class="btn-secondary"
                  invisible="(state == 'cancel') or (x_studio_inventory_short != True)"/>
          <button type="action"
                  name="%(BugFix-Sales.server_action_2341_sls_create_customer_payment)d"
                  string="Create Customer Payment"
                  class="btn-primary"
                  invisible="(state == 'cancel') or (state == 'draft') or (state == 'sent')"/>
        </xpath>

        <!--1.2.14 Project Item Approval (Slice B-Proj, v0.1.0.128).
             Ported from CDB view 2304. Sibling to the 5 sub-slices of
             Slice B (B-Acc lives in BugFix-Accounting, B-Pur lives in
             BugFix-Purchase). Only this piece stays in BugFix-Sales
             because its xmlid (server_action_2138) is Sales-pinned and
             uses no cross-repo refs.  -->
        <xpath expr="//sheet" position="inside">
          <field name="x_studio_project_item_request_sent" invisible="1"/>
          <field name="x_studio_project_item_approved" invisible="1"/>
        </xpath>
        <xpath expr="//header" position="inside">
          <button type="action"
                  name="%(BugFix-Sales.server_action_2138_proj_project_item_approval_request_sent_validate)d"
                  string="Approve Project Item"
                  class="btn-primary"
                  studio_approval="True"
                  invisible="(state == 'cancel') or ((x_studio_project_item_request_sent == False) or ((x_studio_project_item_approved == True) or (x_studio_expired == True)))"/>
        </xpath>


        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
      </data>
    </field>
  </record>
