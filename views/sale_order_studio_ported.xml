  <record id="ported_odoo_studio_sale_ord_d30b53b2_bf08_42d7_a477_18497e66a5f5" model="ir.ui.view">
    <field name="name">Odoo Studio: sale.order.tree customization</field>
    <field name="model">sale.order</field>
    <field name="key">studio_customization.odoo_studio_sale_ord_d30b53b2-bf08-42d7-a477-18497e66a5f5</field>
    <field name="type">tree</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="sale.sale_order_tree"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//tree[1]" position="attributes">
          <attribute name="create">false</attribute>
        </xpath>
        <xpath expr="//tree[1]/field[@name='name']" position="after">
          <field name="x_studio_quotation_type" optional="show"/>
        </xpath>
        <xpath expr="//field[@name='date_order']" position="after">
          <field name="create_date" optional="show" widget="date"/>
        </xpath>
        <xpath expr="//field[@name='amount_total']" position="attributes">
          <attribute name="sum">Sum of Total</attribute>
        </xpath>
        <xpath expr="//field[@name='invoice_status']" position="after">
          <field name="id" optional="show" column_invisible="1"/>
          <xpath expr="//field[@name='currency_id']" position="move"/>
          <field name="x_studio_credit_limit_approved" optional="hide"/>
          <field name="x_studio_overdue_approved" optional="hide"/>
          <field name="x_studio_bank_guarantee_approved" optional="hide"/>
          <field name="x_studio_temporary_credit_approved" optional="hide"/>
          <field name="x_studio_over_commission_approved" optional="hide"/>
          <field name="x_studio_margin_approved" optional="hide"/>
          <field name="x_studio_overdue" optional="hide"/>
          <field name="x_studio_over_credit" optional="hide"/>
          <field name="x_studio_over_bank_guarantee" optional="hide"/>
          <field name="x_studio_margin_exceed" optional="hide"/>
          <field name="x_studio_over_commission" optional="hide"/>
        </xpath>
        <xpath expr="//field[@name='state']" position="attributes">
          <attribute name="optional">hide</attribute>
          <attribute name="invisible"/>
        </xpath>
      </data>
    </field>
  </record>
