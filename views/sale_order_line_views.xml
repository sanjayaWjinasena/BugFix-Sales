  <record id="ported_view_3259_odoo_studio_sale_order_line_tree_customi" model="ir.ui.view">
    <field name="name">Odoo Studio: sale.order.line.tree customization</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale.view_order_line_tree"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='order_id']" position="attributes">
          <attribute name="string">Sales Order Ref</attribute>
        </xpath>
        <xpath expr="//field[@name='order_partner_id']" position="after">
          <field name="invoice_status"/>
          <field name="warehouse_id" column_invisible="1"/>
        </xpath>
        <xpath expr="//tree[1]/field[@name='name']" position="after">
          <field optional="show" name="x_studio_price_unit_original" string="Price Unit Original" column_invisible="1"/>
        </xpath>
        <xpath expr="//field[@name='product_uom_qty']" position="attributes">
          <attribute name="string">Order Qty</attribute>
        </xpath>
        <xpath expr="//field[@name='product_uom_qty']" position="after">
          <field name="price_unit" optional="show"/>
        </xpath>
        <xpath expr="//field[@name='qty_delivered']" position="attributes">
          <attribute name="string">Delivered Qty</attribute>
        </xpath>
        <xpath expr="//field[@name='qty_delivered']" position="after">
          <field name="qty_to_deliver"/>
        </xpath>
        <xpath expr="//field[@name='qty_invoiced']" position="attributes">
          <attribute name="string">Invoiced Qty</attribute>
        </xpath>
        <xpath expr="//field[@name='qty_to_invoice']" position="attributes">
          <attribute name="string">Qty To Invoice</attribute>
        </xpath>
        <xpath expr="//field[@name='qty_to_invoice']" position="after">
          <field name="x_studio_req_qty" optional="show" widget="many2one_reference"/>
          <field name="x_studio_production_completed" optional="show"/>
          <field name="x_studio_many2one_field_btM1W" optional="show"/>
        </xpath>
        <xpath expr="//field[@name='product_uom']" position="attributes">
          <attribute name="string">UOM</attribute>
        </xpath>
        <xpath expr="//field[@name='route_id']" position="after">
          <field name="discount"/>
        </xpath>
        <xpath expr="//field[@name='price_subtotal']" position="after">
          <xpath expr="//field[@name='salesman_id']" position="move"/>
          <field name="create_uid"/>
          <field name="create_date"/>
          <field name="x_studio_category" optional="hide"/>
          <field name="x_studio_project_no" optional="hide"/>
        </xpath>
      </data>
    </field>
  </record>
