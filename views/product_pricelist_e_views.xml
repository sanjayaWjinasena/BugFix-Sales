<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Sales: Phase E - 1 views for product.pricelist -->
<odoo>
  <data>
    <record id="view_5064_odoo_studio_product_pricelist_form_customization_e" model="ir.ui.view">
      <field name="name">Odoo Studio: product.pricelist.form customization</field>
      <field name="model">product.pricelist</field>
      <field name="type">form</field>
      <field name="priority">160</field>
      <field name="inherit_id" ref="product.product_pricelist_view"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//form[1]/sheet[1]/group[1]/group[@name='pricelist_settings']/field[@name='currency_id']" position="after">
    <field name="x_studio_group_type" string="Group Type" required="1"/>
    <field name="x_studio_order_payment_method" string="Order Payment Method" required="1"/>
    <field name="x_studio_project_price_list" string="Project Price List"/>
  </xpath>
  <xpath expr="//form[1]/sheet[1]/group[1]/group[@name='pricelist_settings']/field[@name='company_id']" position="attributes">
    <attribute name="force_save">True</attribute>
    <attribute name="readonly">1</attribute></xpath>
  <xpath expr="//field[@name='date_end']" position="after">
    <field optional="show" name="x_studio_price_confirmed" string="Price Confirmed"/>
  </xpath>
</data>
      </field>
    </record>

  </data>
</odoo>