  <record id="ported_view_3030_odoo_studio_product_product_tree_customi" model="ir.ui.view">
    <field name="name">Odoo Studio: product.product.tree customization</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_product_tree_view"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='virtual_available']" position="after">
          <field name="property_account_expense_id" optional="show"/>
        </xpath>
        <xpath expr="//field[@name='uom_id']" position="after">
          <field name="id"/>
        </xpath>
      </data>
    </field>
  </record>
